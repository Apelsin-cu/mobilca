{
  "name": "shelflife-workspace",
  "version": "1.0.0",
  "description": "Root helper package for the ShelfLife workspace. The active Expo app lives in ./helfifexpo.",
  "private": true,
  "scripts": {
    "install:app": "npm --prefix ./helfifexpo install",
    "start": "npm --prefix ./helfifexpo start",
    "android": "npm --prefix ./helfifexpo run android",
    "ios": "npm --prefix ./helfifexpo run ios",
    "web": "npm --prefix ./helfifexpo run web",
    "typecheck": "npm --prefix ./helfifexpo exec -- tsc -p ./helfifexpo/tsconfig.json --noEmit"
  }
}
